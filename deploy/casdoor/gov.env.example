# even-auth-gov 治理服务配置 —— 复制为 gov.env 后填写。gov.env 已在 .gitignore,切勿提交。
# compose 里已固定 CASDOOR_ENDPOINT=http://casdoor:8000 与 APPROVAL_STORE_FILE=/data/approvals.json。
# 下面的密钥项生产应由密管注入,不要长期明文落盘。

# ── 飞书应用(发审批卡片 / 查在职状态 / 收离职事件)──
# 必须与 Casdoor Lark provider 用同一个飞书应用:open_id 是按应用区分的,Casdoor 里的 sub 才能对上。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# ── 审批人(飞书 open_id)──
APPROVER_FEISHU_ID=                # 全局兜底审批人,也接收离职禁用失败告警
# APPROVER_CS_HUB=                 # 按应用覆盖:APPROVER_<APP 大写,'-'→'_'>
DEFAULT_APP=cs-hub                 # Casdoor signup webhook 不带 app 时落到这个应用

# ── Casdoor Admin API ──
CASDOOR_ORG=
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=

# ── Casdoor webhook 共享 token(只给 Casdoor 用,不发给接入应用)──
CASDOOR_WEBHOOK_SECRET=            # 强随机值;Casdoor webhook 自定义头里填同值
CASDOOR_WEBHOOK_HEADER=X-Webhook-Token

# ── /request-access:接入应用转交用户的 id_token,网关验 Casdoor 签名 ──
# 登记哪些应用可以上报:<应用短名>:<该应用在 Casdoor 的 clientId>,逗号分隔。未登记 → 403。
APP_CLIENT_IDS=                    # 如 finance:3f2a...,crm:9b1c...
# id_token 的 iss 期望值 = Casdoor 对外地址(浏览器访问的那个,如 https://auth.example.com)。
# 网关走内网 http://casdoor:8000 访问,和 iss 不同,所以要单独配;留空则不校验 iss。
CASDOOR_ISSUER=

# ── 可选 ──
# SSO_RECONCILE_CRON=0 8 * * *          # 每日对账(跑完顺带做权限核对)
# SSO_PENDING_SWEEP_CRON=30 * * * *     # 待批扫描:补发/催办/超时升级
# SCHEDULER_TIMEZONE=Asia/Shanghai
# SSO_PENDING_RESEND_SECONDS=86400      # 已送达仍待批的催办间隔
# APPROVAL_ESCALATE_HOURS=24            # 审批人收到卡片后多少小时没处理就升级;0 = 关闭
# APPROVAL_ESCALATE_TO=                 # 升级给谁(飞书 open_id),留空 = APPROVER_FEISHU_ID
# ACCESS_REPORT_ALERT=true              # 每日权限核对发现高/中级异常时推给 APPROVER_FEISHU_ID
# SSO_LOG_LEVEL=INFO
